{
  "mode": "research",
  "backend": "chroma",
  "index_path": "local_indexes/chroma",
  "registry_path": "local_indexes/sources.json",
  "embedding_model": "BAAI/bge-large-en-v1.5",
  "embedding_dimension": 1024,
