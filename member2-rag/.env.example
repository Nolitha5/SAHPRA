# Copy to .env and adjust. All values are optional; defaults are shown.

# --- Storage ---------------------------------------------------------------
# Relative paths are resolved from the member2-rag folder.
M2_CHROMA_DIR=data/chroma
# Built by: python scripts/build_knowledge_base.py (16 guidelines, sources/kb_v2_manifest.json)
M2_COLLECTION_NAME=kb_v2_large_w300

# --- Embeddings -----------------------------------------------------------
# BAAI/bge-large-en-v1.5 (1024-dim, ~1.3 GB) is the project default.
# On a low-resource laptop use BAAI/bge-small-en-v1.5 (384-dim, ~130 MB) and
# a separate collection name, e.g. kb_v2_small_w300 (then rebuild).
M2_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
M2_EMBEDDING_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages: "
M2_DEVICE=cpu
M2_EMBEDDING_BATCH_SIZE=16

# --- Reranking ------------------------------------------------------------
# bge-reranker-base (~1.1 GB) is the default; bge-reranker-large (~2.2 GB)
# is more accurate but slower. Set M2_RERANKER_ENABLED=false to skip it.
M2_RERANKER_ENABLED=true
M2_RERANKER_MODEL=BAAI/bge-reranker-base
M2_RERANKER_MAX_LENGTH=512
M2_RERANKER_BATCH_SIZE=16

# --- Retrieval ------------------------------------------------------------
M2_CANDIDATE_K=20
M2_FINAL_K=5
M2_MAX_QUERY_CHARS=2000

# --- Evidence sufficiency heuristics (calibrate on the benchmark!) --------
# Raw cross-encoder logit; NOT a probability.
M2_MIN_RERANK_SCORE=0.0
# Cosine similarity, used only when reranking is disabled.
M2_MIN_RETRIEVAL_SCORE=0.55

# --- Logging --------------------------------------------------------------
M2_LOG_LEVEL=INFO
M2_LOG_JSON=true

# --- Hugging Face (optional) ----------------------------------------------
# Where downloaded models are cached. Uncomment to move it off the C: drive.
# HF_HOME=D:/hf-cache
# After the first successful search (models downloaded), uncomment these so the
# server never contacts Hugging Face. Without them a slow or blocked connection
# can make the first search hang for minutes.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# --- Web API / dashboard --------------------------------------------------
# The server only listens on this computer by default. Do not change to
# 0.0.0.0 unless you understand who else can reach it.
M2_API_HOST=127.0.0.1
# If port 8000 is taken on your computer (e.g. by Docker), use another, e.g. 8010.
# `npm run dev` reads this value too, so the dashboard follows automatically.
M2_API_PORT=8000
# Editing in the dashboard (import/delete passages, edit benchmark questions)
# is OFF unless you set a token of at least 12 characters. Share it only with
# teammates who should be able to change the knowledge base.
M2_ADMIN_TOKEN=
M2_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
M2_MAX_UPLOAD_MB=20
# Benchmark questions shown and edited in the dashboard (ICH pilot, labels for the
# KB v2 editions). Member 5's expert set will replace it.
M2_BENCHMARK_FILE=benchmarks/pilot_kb_v2.jsonl
